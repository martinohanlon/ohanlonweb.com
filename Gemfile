source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# Ruby 3+ no longer bundles webrick, but `jekyll serve` needs it locally.
gem "webrick", "~> 1.8"

# Used by bin/update-blog-posts.rb; pinned explicitly since rss is moving
# from a default gem to a bundled one in newer Ruby versions.
gem "rss", "~> 0.3"
